rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTransporterOwner() {
      return isSignedIn() &&
        resource.data.transporterId == request.auth.uid;
    }

    function isTransporter() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/transporters/$(request.auth.uid));
    }

    function isPassenger() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/passengers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'passenger')
      );
    }

    // ============================================
    // ADMIN COLLECTION
    // ============================================
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ============================================
    // SYSTEM SETTINGS (admin panel)
    // ============================================
    match /system_settings/{document} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (isTransporter() && resource.data.transporterId == request.auth.uid)
      );
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTransporter() && 
         request.resource.data.userType == 'driver' && 
         request.resource.data.transporterId == request.auth.uid)
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isTransporter() && 
         resource.data.transporterId == request.auth.uid &&
         request.resource.data.userType == 'driver')
      );
    }

    // ============================================
    // PASSENGERS COLLECTION
    // ============================================
    match /passengers/{passengerId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow read, write: if request.auth != null && request.auth.uid == passengerId;
      allow create: if request.auth != null && request.auth.uid == passengerId;
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================
    // DRIVERS COLLECTION
    // ============================================
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.transporterId == request.auth.uid ||
        request.auth.uid == driverId ||
        isPassenger()
      );
      allow write: if isSignedIn();
    }

    // ============================================
    // TRANSPORTERS COLLECTION
    // ============================================
    match /transporters/{transporterId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow read, write: if request.auth != null && request.auth.uid == transporterId;
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================
    // BUSES COLLECTION (CHANGED: Added driver access)
    // ============================================
    match /buses/{busId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == resource.data.transporterId ||
        exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
      );
      allow delete: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == resource.data.transporterId
      );
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == request.resource.data.transporterId
      );
    }

    // ============================================
    // TRIPS COLLECTION
    // ============================================
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (isAdmin() || request.auth.uid == request.resource.data.transporterId);
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.driverId == request.auth.uid ||
        resource.data.transporterId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['availableSeats', 'heldSeats', 'updatedAt'])
      );
      allow delete: if isSignedIn() &&
        (isAdmin() || resource.data.transporterId == request.auth.uid);

      match /seats/{seatId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (isAdmin() || isTransporter());

        // CHANGED: Added booking-based seat release condition for cleanupExpiredBookings
        allow update: if isSignedIn() && (
          isAdmin() ||
          isTransporter() ||
          (resource.data.status == 'available' && 
           request.resource.data.status == 'reserved' &&
           request.resource.data.reservedBy == request.auth.uid) ||
          (resource.data.status == 'reserved' && 
           resource.data.reservedBy == request.auth.uid && 
           request.resource.data.status == 'available') ||
          (resource.data.status == 'reserved' && 
           resource.data.reservedBy == request.auth.uid && 
           request.resource.data.status == 'booked') ||
          (resource.data.status == 'available' && 
           request.resource.data.status == 'booked' &&
           request.resource.data.bookedBy == request.auth.uid) ||
          (resource.data.status == 'reserved' && 
           resource.data.reservedBy == request.auth.uid && 
           request.resource.data.status == 'reserved' &&
           request.resource.data.reservedBy == request.auth.uid) ||
          (resource.data.status == 'reserved' &&
           resource.data.reservedUntil != null &&
           resource.data.reservedUntil < request.time &&
           request.resource.data.status == 'available') ||
          (resource.data.bookingId != null &&
           exists(/databases/$(database)/documents/bookings/$(resource.data.bookingId)) &&
           get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid &&
           request.resource.data.status == 'available')
        );

        allow delete: if false;
      }
    }

    // ============================================
    // BOOKINGS COLLECTION
    // ============================================
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ============================================
    // DRIVER LOCATIONS
    // ============================================
    match /driver_locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /driver_location/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================
    // ROUTES COLLECTION
    // ============================================
    match /routes/{routeId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.uid == resource.data.transporterId);
      allow create: if request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.uid == request.resource.data.transporterId);
    }

    // ============================================
    // CITIES COLLECTION
    // ============================================
    match /cities/{cityId} {
      allow read: if true;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================
    // SEARCHES COLLECTION
    // ============================================
    match /searches/{searchId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // ============================================
    // SEARCH HISTORY COLLECTION
    // ============================================
    match /search_history/{historyId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // ============================================
    // TOURS COLLECTION
    // ============================================
    match /tours/{tourId} {
      allow read, update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // ============================================
    // NOTIFICATIONS & DELAYS & RATINGS
    // ============================================
    match /transporter_notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        !('transporterId' in resource.data) ||
        resource.data.transporterId == request.auth.uid
      );
      allow write: if isSignedIn();
    }

    match /passenger_notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /delays/{delayId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ============================================
    // TRANSPORTER ALERTS
    // ============================================
    match /alerts/{alertId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        !('transporterId' in resource.data) ||
        resource.data.transporterId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.transporterId == request.auth.uid
      );
    }

    // ============================================
    // TRANSPORTER SETTINGS
    // ============================================
    match /settings/{transporterId} {
      allow read, write: if request.auth != null && request.auth.uid == transporterId;
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================
    // FLEET / OPS SUPPORT
    // ============================================
    match /maintenance/{maintenanceId} {
      allow read, write: if request.auth != null;
    }

    match /trip_activities/{activityId} {
      allow read, write: if request.auth != null;
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /driver_credentials/{driverId} {
      allow read, write: if request.auth != null;
    }

    match /vehicle_checks/{checkId} {
      allow read, write: if request.auth != null;
    }

    match /vehicle_issues/{issueId} {
      allow read, write: if request.auth != null;
    }

    match /emergencies/{emergencyId} {
      allow read, write: if request.auth != null;
    }

    // ============================================
    // TRIP SCHEDULES COLLECTION
    // ============================================
    match /tripSchedules/{scheduleId} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.uid == resource.data.transporterId);
      allow create: if request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.uid == request.resource.data.transporterId);
    }

    // ============================================
    // TEMP SELECTIONS (unauthenticated analytics)
    // ============================================
    match /temp_selections/{selectionId} {
      allow create: if true;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}